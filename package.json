{
  "name": "meeto",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source peer-to-peer video meetings",
  "author": {
    "name": "Meeto contributors",
    "email": "meeto@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@capacitor/android": "7.4.0",
    "@capacitor/cli": "7.4.0",
    "@capacitor/core": "7.4.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "electron": "36.4.0",
    "electron-builder": "26.0.12",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "trystero": "0.26.0"
  },
  "build": {
    "appId": "app.meeto.desktop",
    "productName": "Meeto",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Meeto-Setup.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "Meeto.${ext}",
      "icon": "build/icon.png",
      "category": "Network"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Meeto.${ext}"
    }
  },
  "homepage": "https://github.com/rayan-afkkk/meeto"
}
